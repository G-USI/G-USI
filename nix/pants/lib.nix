# Shared Pants builder logic - the single home of version resolution,
# arch handling and pants.toml reading. Consumed by flake.nix (lib,
# pinned, packages, checks, devShells) and devenv.nix.
#
# Instantiate against the nixpkgs the build should target:
#   import ./nix/pants/lib.nix {
#     pkgs = nixpkgs.legacyPackages.${system};
#     pkgs39 = nixpkgs-py39.legacyPackages.${system};
#   }
# pkgs39 carries the python3.9 interpreter for cp39-era releases
# (2.21-2.24). Pass null where that nixpkgs branch is unavailable
# (devenv): a cp39-era pin then fails with an informative message
# instead of a missing-attribute error.
{ pkgs, pkgs39 ? null }:

let
  # Per-version release data (url, hash, python tag, lockfile-exact
  # deps) generated by nix/pants/scripts/generate.py - see
  # nix/pants/versions.nix.
  versionData = import ./versions.nix;

  latestVersion = pkgs.lib.last (
    pkgs.lib.naturalSort (pkgs.lib.attrNames versionData)
  );

  # The version's arch set for a system, or null when the release is
  # unknown for that system or not packaged there (generated data
  # marks absent arches with an explicit null, which `or` cannot
  # intercept). NEVER throws - callers decide how to degrade.
  archOrNull = { version, system }:
    let v = versionData.${version} or null; in
    if v == null then null else v.${system} or null;

  readPantsVersion = file:
    let
      pantsToml = builtins.fromTOML (builtins.readFile file);
      global = pantsToml.GLOBAL or pantsToml.global or null;
    in
    if global == null then
      throw "pants-nix: no [GLOBAL] section in ${toString file}"
    else
      global.pants_version;

  # Interpreter era mapping: the release wheel's CPython tag decides
  # which nixpkgs python builds it. Takes explicit pkgs'/pkgs39' so
  # fromPantsToml can build against caller-supplied nixpkgs.
  mkPantsFor = pkgs': pkgs39': { version, extraPythons ? [ ] }:
    let
      system = pkgs'.stdenv.hostPlatform.system;
      info = versionData.${version} or (throw ''
        pants-nix: Pants ${version} is not packaged. Supported range: 2.21.0-${latestVersion}. Generate: nix/pants/scripts/list-versions.sh > /tmp/versions.txt && nix/pants/scripts/gen-versions.sh /tmp/versions.txt; then commit nix/pants/versions/.
      '');
      a = archOrNull { inherit version system; };
      arch =
        if a == null then throw "pants-nix: Pants ${version} is not packaged for ${system}." else a;
      interpreter =
        if info.python == "python39" then
          (if pkgs39' == null
          then throw "pants-nix: cp39-era Pants requires nixpkgs-py39 (unavailable in this consumer)"
          else pkgs39'.python39)
        else if info.python == "python311" then pkgs'.python311
        else if info.python == "python314" then pkgs'.python314
        else throw "pants-nix: unsupported interpreter ${info.python} for ${version}";
    in
    pkgs'.callPackage ./default.nix {
      inherit interpreter extraPythons;
      pantsVersion = version;
      pantsUrl = arch.url;
      pantsHash = arch.hash;
      deps = arch.deps;
    };

in
{
  inherit versionData latestVersion archOrNull;

  mkPants = mkPantsFor pkgs pkgs39;

  # Read a repo's pants.toml ([GLOBAL].pants_version) and build
  # exactly the pinned version. target is either a toml path
  # (current behavior) or { file = ./pants.toml; extraPythons = [...]; }.
  # Takes explicit pkgs/pkgs39 so the flake's system-agnostic lib can
  # re-export it unchanged.
  fromPantsToml = pkgs': pkgs39': target:
    if builtins.isPath target then
      mkPantsFor pkgs' pkgs39' { version = readPantsVersion target; }
    else if builtins.isAttrs target then
      mkPantsFor pkgs' pkgs39' {
        version = readPantsVersion target.file;
        extraPythons = target.extraPythons or [ ];
      }
    else
      throw "pants-nix: fromPantsToml target must be a path or an attrset { file, extraPythons }";
}
